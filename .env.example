# Primary path: local Ollama. Change WORKSHOP_MODEL to an approved provider/model
# and set its normal provider key if you cannot run Ollama.
WORKSHOP_MODEL=ollama/qwen3.5:4b
WORKSHOP_MODEL_BASE_URL=http://localhost:11434
WORKSHOP_EMBEDDING_PROVIDER=ollama
WORKSHOP_EMBEDDING_MODEL=nomic-embed-text
WORKSHOP_OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
CREWAI_TRACING_ENABLED=false
# Advanced track only. Keep this file free of real credentials.
WORKSHOP_NEMO_ENABLED=false
WORKSHOP_LANCEDB_RAG_ENABLED=false
WORKSHOP_DATABASE_URL=
WORKSHOP_REDIS_URL=
WORKSHOP_API_TOKEN=
WORKSHOP_APPROVAL_TOKEN=
WORKSHOP_LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
WORKSHOP_API_URL=http://localhost:8000
WORKSHOP_POSTGRES_PASSWORD=
